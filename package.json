{
  "name": "d2-tools",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @d2-tools/desktop dev",
    "build": "pnpm -r build",
    "encoding:check": "node scripts/check-encoding.mjs",
    "docs:check": "node scripts/check-doc-policy.mjs && pnpm encoding:check",
    "test": "pnpm docs:check && pnpm vitest --run test/architecture-boundaries.test.ts test/release-assets.test.ts test/release-config.test.ts test/release-notes.test.ts test/release-publication.test.ts test/release-readiness.test.ts test/tauri-environment.test.ts test/updater-metadata.test.ts && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "release:preview": "node scripts/preview-release-notes.mjs",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:verify": "node scripts/verify-release-publication.mjs",
    "release:verify-assets": "node scripts/verify-release-assets.mjs",
    "release:verify-updater": "node scripts/verify-updater-metadata.mjs",
    "tauri:env": "node scripts/check-tauri-environment.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "glob": "^13.0.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
