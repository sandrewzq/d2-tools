{
  "name": "d2-tools",
  "version": "0.0.4",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @d2-tools/desktop dev",
    "dev:electron": "pnpm --filter @d2-tools/desktop dev:electron",
    "build": "pnpm -r build",
    "test": "pnpm build && vitest --run",
    "typecheck": "pnpm --filter @d2-tools/core build && pnpm -r typecheck",
    "package:win": "pnpm --filter @d2-tools/desktop package:win"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
