{
  "name": "d2-tools",
  "version": "0.0.11",
  "private": true,
  "description": "A Windows-first Chinese Destiny 2 desktop companion for everyday players.",
  "author": "zhangqi",
  "homepage": "https://github.com/sandrewzq/d2-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrewzq/d2-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sandrewzq/d2-tools/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @d2-tools/desktop dev",
    "dev:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-desktop.ps1",
    "dev:electron": "pnpm --filter @d2-tools/desktop dev:electron",
    "dev:prototype": "pnpm --filter @d2-tools/prototype dev",
    "dev:web": "pnpm --filter @d2-tools/web dev",
    "visual:home": "node scripts/visual-home-check.mjs",
    "visual:ai": "node scripts/visual-ai-check.mjs",
    "visual:all": "node scripts/visual-all-check.mjs",
    "visual:loadouts": "node scripts/visual-home-check.mjs --page loadouts",
    "visual:settings": "node scripts/visual-home-check.mjs --page settings",
    "build": "pnpm -r build",
    "check": "pnpm docs:check && git diff --check",
    "encoding:check": "node scripts/check-encoding.mjs",
    "docs:check": "node scripts/check-doc-policy.mjs && pnpm encoding:check",
    "test:fast": "vitest --run",
    "test:docs": "vitest --run scripts/check-doc-policy.test.mjs scripts/check-encoding.test.mjs scripts/dev-tools.test.mjs",
    "test:ui": "node scripts/run-test-set.mjs ui",
    "test:desktop": "vitest --run packages/desktop/test",
    "test:desktop:account": "node scripts/run-test-set.mjs desktop-account",
    "test:desktop:ai": "node scripts/run-test-set.mjs desktop-ai",
    "test:desktop:loadouts": "node scripts/run-test-set.mjs desktop-loadouts",
    "test:desktop:vault": "node scripts/run-test-set.mjs desktop-vault",
    "test:desktop-wiring": "node scripts/run-test-set.mjs desktop-wiring",
    "test:release": "node scripts/run-test-set.mjs release",
    "test": "pnpm docs:check && pnpm build && vitest --run",
    "typecheck:ui": "pnpm --filter @d2-tools/ui typecheck && pnpm --filter @d2-tools/prototype typecheck && pnpm --filter @d2-tools/web typecheck",
    "typecheck:desktop-fast": "pnpm --filter @d2-tools/desktop typecheck",
    "typecheck:desktop": "pnpm --filter @d2-tools/core build && pnpm --filter @d2-tools/http build && pnpm --filter @d2-tools/desktop typecheck",
    "typecheck": "pnpm --filter @d2-tools/core build && pnpm --filter @d2-tools/http build && pnpm -r typecheck",
    "verify": "pnpm check && pnpm test:fast",
    "verify:vibe:docs": "pnpm test:docs",
    "verify:vibe:ui": "pnpm test:ui",
    "verify:vibe:desktop": "pnpm test:desktop-wiring",
    "verify:vibe:desktop:account": "pnpm test:desktop:account",
    "verify:vibe:desktop:ai": "pnpm test:desktop:ai",
    "verify:vibe:desktop:loadouts": "pnpm test:desktop:loadouts",
    "verify:vibe:desktop:vault": "pnpm test:desktop:vault",
    "verify:docs": "pnpm check && pnpm test:docs",
    "verify:ui": "pnpm typecheck:ui && pnpm test:ui",
    "verify:desktop": "pnpm typecheck:desktop-fast && pnpm test:desktop-wiring",
    "verify:desktop:account": "pnpm typecheck:desktop-fast && pnpm test:desktop:account",
    "verify:desktop:ai": "pnpm typecheck:desktop-fast && pnpm test:desktop:ai",
    "verify:desktop:loadouts": "pnpm typecheck:desktop-fast && pnpm test:desktop:loadouts",
    "verify:desktop:vault": "pnpm typecheck:desktop-fast && pnpm test:desktop:vault",
    "verify:release": "pnpm check && pnpm test:docs && pnpm test:release",
    "package:win": "pnpm --filter @d2-tools/desktop package:win",
    "package:local": "pnpm build && vitest --run && pnpm typecheck && pnpm package:win",
    "release:preview": "node scripts/preview-release-notes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
