{
  "name": "@d2-tools/desktop",
  "version": "0.0.10",
  "private": true,
  "description": "Windows desktop app for d2-tools, a Chinese Destiny 2 companion.",
  "author": "zhangqi",
  "homepage": "https://github.com/sandrewzq/d2-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrewzq/d2-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sandrewzq/d2-tools/issues"
  },
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 53217 --strictPort",
    "dev:electron": "set NODE_ENV=development&& electron dist/main/main.js",
    "clean": "node -e \"var fs=require('node:fs');var g=require('node:path').join(__dirname,'tsconfig.');try{fs.rmSync(g+'main.tsbuildinfo',{force:true})}catch(e){}try{fs.rmSync(g+'renderer.tsbuildinfo',{force:true})}catch(e){}fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && pnpm --filter @d2-tools/core build && pnpm --filter @d2-tools/http build && vite build && tsc -p tsconfig.main.json && node scripts/build-preload.cjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest --root ../.. --run",
    "package:win": "pnpm build && electron-builder --config electron-builder.yml --win nsis --publish never"
  },
  "dependencies": {
    "@d2-tools/app": "workspace:*",
    "@d2-tools/core": "workspace:*",
    "@d2-tools/http": "workspace:*",
    "@d2-tools/services": "workspace:*",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.3"
  }
}
